# ChopCast PIREP collector.
# Install: sudo cp deploy/chopcast.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now chopcast
[Unit]
Description=ChopCast PIREP collector (AWC aircraft reports)
Documentation=https://github.com/SrivatsaChilla/ChopCast
# network-online, not just network: the first poll fires immediately at boot
# and would otherwise race DHCP and burn its retries before the link is up.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/ChopCast
# WorkingDirectory matters: paths.root resolves relative to it, so the
# database lands in ./data/raw/pireps.db.
ExecStart=/home/ec2-user/ChopCast/.venv/bin/chopcast-collector run
Environment=PYTHONUNBUFFERED=1

# The collector loops internally and handles SIGTERM, so systemd only needs
# to cover hard crashes and reboots.
Restart=always
RestartSec=60
KillSignal=SIGTERM
TimeoutStopSec=90

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ec2-user/ChopCast

[Install]
WantedBy=multi-user.target
