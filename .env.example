# ChopCast local environment template.
# Copy to .env and edit. .env is gitignored.

# Active profile: default | dev | prod | ci
# Determines which configs/<profile>.yaml overlay is applied.
CHOPCAST_PROFILE=default

# ---------------------------------------------------------------------------
# Critical: AWC requires a User-Agent that identifies the operator.
# Format: "<app>/<version> (+<contact>)"
# Without a unique UA, requests may be filtered or rate-limited.
# ---------------------------------------------------------------------------
CHOPCAST_COLLECTOR__USER_AGENT="chopcast/0.1 (+your-email@example.com)"

# ---------------------------------------------------------------------------
# Data directory (recommended for cloud-synced repos).
# See ADR-0006. If this repo is under OneDrive/Dropbox/iCloud/Google Drive,
# set this to a non-synced location, e.g.:
#   CHOPCAST_PATHS__ROOT=C:/Users/HP/AppData/Local/ChopCast
# Leave commented to use the repo root.
# ---------------------------------------------------------------------------
# CHOPCAST_PATHS__ROOT=.

# Optional overrides (uncomment to use)
# CHOPCAST_COLLECTOR__POLL_SECONDS=300
# CHOPCAST_API__PORT=8001
# CHOPCAST_LOGGING__LEVEL=DEBUG
